{
    "name": "lanepool",
    "version": "0.1.0",
    "description": "In-memory processing queue for Node.js with an Express adapter.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "test": "jest --config jest.config.js --runInBand",
        "test:watch": "jest --config jest.config.js --watch",
        "test:coverage": "jest --config jest.config.js --coverage --runInBand",
        "test:package": "node scripts/test-package.mjs",
        "docs": "typedoc --options typedoc.json",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "dependencies": {
        "ssignal": "^1.7.0"
    },
    "peerDependencies": {
        "express": ">=4.18 <6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.5.2",
        "eslint": "^10.0.0",
        "express": "^5.1.0",
        "jest": "^30.2.0",
        "super-configs": "^1.25.1",
        "ts-jest": "^29.4.5",
        "typescript": "^5.9.2",
        "typedoc": "^0.28.13",
        "vite": "^8.0.0",
        "vite-plugin-dts": "^5.0.0"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}